/*
Project: Windows Login Failure Detection and Investigation
Use Case: Failed Logins Against Multiple Accounts
Data Source: Synthetic Windows authentication events
*/

index=main EventCode=4625
| stats
    count AS failed_attempts
    dc(Account_Name) AS unique_accounts
    values(Account_Name) AS targeted_accounts
    by Source_IP
| where unique_accounts >= 3
| sort - unique_accounts
